{
  "name": "wanterest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rls": "vitest run tests/rls",
    "test:phase2": "vitest run tests/modules/ingestion.test.ts tests/providers/source-adapters.test.ts tests/providers/bluesky-adapter.test.ts tests/modules/bluesky-ingestion.test.ts tests/rls/phase2-migration.test.ts",
    "test:phase3": "vitest run tests/modules/intelligence.test.ts tests/modules/business-classification.test.ts tests/modules/demand-profile-v2.test.ts tests/rls/phase3-migration.test.ts",
    "test:phase4": "vitest run tests/modules/demand-intelligence.test.ts tests/rls/phase4-migration.test.ts",
    "test:phase5": "vitest run tests/modules/actions.test.ts tests/rls/phase5-migration.test.ts",
    "test:phase6": "vitest run tests/modules/billing.test.ts tests/rls/phase6-migration.test.ts",
    "test:phase7": "vitest run tests/modules/experiments.test.ts tests/modules/source-routing.test.ts tests/modules/query-planning.test.ts tests/modules/monitoring.test.ts tests/rls/phase7-migration.test.ts tests/rls/automatic-monitoring-migration.test.ts tests/smoke/system.test.ts",
    "smoke:signal": "vitest run tests/modules/intelligence.test.ts --reporter=verbose",
    "smoke:demand": "vitest run tests/modules/demand-intelligence.test.ts --reporter=verbose",
    "smoke:actions": "vitest run tests/modules/actions.test.ts --reporter=verbose",
    "smoke:billing": "vitest run tests/smoke/billing.test.ts --reporter=verbose",
    "smoke:bluesky": "node scripts/smoke-bluesky.mjs",
    "smoke:reddit": "node scripts/smoke-reddit.mjs",
    "smoke:github": "node scripts/smoke-github.mjs",
    "smoke:x": "node scripts/smoke-x.mjs",
    "smoke:dodo": "node scripts/smoke-dodo.mjs",
    "smoke:system": "vitest run tests/smoke/system.test.ts --reporter=verbose",
    "smoke:fixture": "vitest run tests/modules/ingestion.test.ts --reporter=verbose",
    "test:trigger": "vitest run tests/trigger --reporter=verbose",
    "trigger:dev": "npx trigger.dev@latest dev start --profile default --env-file .env.local",
    "trigger:deploy": "npx trigger.dev@latest deploy",
    "db:lint": "supabase db lint",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@trigger.dev/sdk": "4.6.3",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@trigger.dev/build": "4.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
