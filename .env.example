NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional server-only Dodo configuration. Required only when invoking the live provider path.
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_API_BASE_URL=https://live.dodopayments.com
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_ANNUAL=
DODO_PRODUCT_GROWTH_MONTHLY=
DODO_PRODUCT_GROWTH_ANNUAL=

# Optional server-only Reddit Data API configuration. Live access remains disabled until Reddit approval.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=wanterest/1.0 by u/your-reddit-account
REDDIT_API_BASE_URL=https://oauth.reddit.com
REDDIT_AUTH_BASE_URL=https://www.reddit.com

# Optional server-only GitHub token. Public issues work without it; a token only
# increases documented API limits and may enable public Discussions GraphQL access.
GITHUB_TOKEN=

# Optional live RLS integration test configuration.
SUPABASE_RLS_TEST_URL=https://your-project.supabase.co
SUPABASE_RLS_TEST_ANON_KEY=your-anon-key
SUPABASE_RLS_WORKSPACE_A=11111111-1111-4111-8111-111111111111
SUPABASE_RLS_WORKSPACE_B=22222222-2222-4222-8222-222222222222
SUPABASE_RLS_MEMBER_B_ID=33333333-3333-4333-8333-333333333333
SUPABASE_RLS_USER_A_TOKEN=member-a-jwt
