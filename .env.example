NEXT_PUBLIC_APP_URL=https://app.wanterest.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional server-only Dodo configuration. Required only when invoking the live provider path.
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Leave blank to select https://test.dodopayments.com or https://live.dodopayments.com from DODO_PAYMENTS_ENVIRONMENT.
DODO_API_BASE_URL=
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_ANNUAL=
DODO_PRODUCT_GROWTH_MONTHLY=
DODO_PRODUCT_GROWTH_ANNUAL=

# Optional server-only Reddit Data API configuration. Live access remains disabled until Reddit approval.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=wanterest/1.0 by u/your-reddit-account
REDDIT_API_BASE_URL=https://oauth.reddit.com
REDDIT_AUTH_BASE_URL=https://www.reddit.com

# Optional server-only GitHub token. Public issues work without it; a token only
# increases documented API limits and may enable public Discussions GraphQL access.
GITHUB_TOKEN=

# Optional server-only X API v2 configuration. Search is bounded and app-only.
X_BEARER_TOKEN=
X_API_BASE_URL=https://api.x.com
X_MAX_POSTS_PER_SCAN=10
X_POST_READ_COST_USD=0.005
X_COST_CONFIG_VERSION=x-post-read-v1

# Optional server-only Source Expansion v1 providers. Product Hunt requires an
# approved commercial-use API token; it remains disabled when absent.
PRODUCT_HUNT_API_TOKEN=
# Stack Exchange works anonymously with a lower quota; a request key raises the documented throttle.
STACK_EXCHANGE_API_KEY=
# Public Web accepts only explicit URLs from an approved discovery provider and uses the SSRF-safe fetcher.
# It has no generic crawler/search key in v1.

# Optional approved review APIs. G2 resolves each Wanterest product or competitor
# through the official Products API; Trustpilot still requires its business unit.
G2_API_KEY=
# Optional: Trustpilot is skipped when credentials are absent.
TRUSTPILOT_API_KEY=
TRUSTPILOT_BUSINESS_UNIT_ID=
TRUSTPILOT_BUSINESS_URL=https://www.trustpilot.com
YOUTUBE_API_KEY=
GITLAB_TOKEN=

# Server-only OpenAI product-understanding provider. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional; defaults to the bounded, low-cost structured-output model.
OPENAI_MODEL=gpt-4.1-mini

# Optional server-only monitoring digest/alert email delivery. Delivery remains
# disabled unless both values are present.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Trigger.dev v4 background orchestration. Use the development environment API
# key locally and make it available to both Next.js and `npm run trigger:dev`.
# Keep the secret server-only.
TRIGGER_SECRET_KEY=
# Use direct only for explicit local/debug execution; production should use remote.
TRIGGER_LOCAL_EXECUTION=remote

# Optional live RLS integration test configuration.
SUPABASE_RLS_TEST_URL=https://your-project.supabase.co
SUPABASE_RLS_TEST_ANON_KEY=your-anon-key
SUPABASE_RLS_WORKSPACE_A=11111111-1111-4111-8111-111111111111
SUPABASE_RLS_WORKSPACE_B=22222222-2222-4222-8222-222222222222
SUPABASE_RLS_MEMBER_B_ID=33333333-3333-4333-8333-333333333333
SUPABASE_RLS_USER_A_TOKEN=member-a-jwt
